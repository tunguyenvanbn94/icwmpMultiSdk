From 52be70a986d435e78059fca6d1b3bd8500247ec2 Mon Sep 17 00:00:00 2001
From: TuNV <steven.nguyen.bn@gmail.com>
Date: Thu, 24 Sep 2026 11:26:19 +0700
Subject: [PATCH] [icwmp apply] Run on Python 3.6, the SDK build hosts are
 older than this tree

Path.is_relative_to() is 3.9 and reached a build host as an AttributeError
traceback before anything was installed.  Replaced with within(), a
relative_to() in a try block, plus an explicit version check so an older
interpreter says so instead of crashing halfway.

release/tests/verify-apply.py now gates both ways: an AST scan of apply.py
for names that only exist after 3.6, and a dry-run of both SDK fixtures with
the 3.9 pathlib methods deleted from the interpreter.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 release/apply.py                              |  18 +++++-
 .../__pycache__/verify-apply.cpython-310.pyc  | Bin 0 -> 8686 bytes
 release/tests/verify-apply.py                 |  52 ++++++++++++++++++
 3 files changed, 69 insertions(+), 1 deletion(-)
 create mode 100644 release/tests/__pycache__/verify-apply.cpython-310.pyc

diff --git a/release/apply.py b/release/apply.py
index a7a820c..dd0c1ce 100755
--- a/release/apply.py
+++ b/release/apply.py
@@ -15,6 +15,22 @@ from pathlib import Path
 
 HERE = Path(__file__).resolve().parent
 
+# The SDK build hosts are older than this workspace: keep to what Python 3.6
+# has.  Path.is_relative_to() is 3.9 and was the one thing that slipped
+# through -- see within() below.
+if sys.version_info < (3, 6):
+    sys.exit("apply.py needs Python 3.6 or newer, found %d.%d"
+             % (sys.version_info[0], sys.version_info[1]))
+
+
+def within(path, other):
+    """path is other or lies under it.  Path.is_relative_to() without 3.9."""
+    try:
+        path.relative_to(other)
+        return True
+    except ValueError:
+        return False
+
 
 def digest(path):
     return hashlib.sha256(path.read_bytes()).hexdigest()
@@ -243,7 +259,7 @@ def main():
     try:
         metadata = verify_bundle(HERE)
         target = args.target.resolve(strict=True)
-        if HERE == target or HERE.is_relative_to(target) or target.is_relative_to(HERE):
+        if HERE == target or within(HERE, target) or within(target, HERE):
             raise ValueError("extract the bundle outside the SDK target directory")
         sdk = args.sdk
         if not sdk:
