From fc25ca0147489148249529a2708b89c57e530560 Mon Sep 17 00:00:00 2001
From: TuNV <tunguyenvanbn94@gmail.com>
Date: Thu, 24 Sep 2026 14:54:11 +0700
Subject: [PATCH] [icwmp app] Rename the static dm_add_end_session of the ubus
 dm object

  ../icwmp_dm.c:139:13: error: conflicting types for 'dm_add_end_session'
  ../dmtr098.h:532:5: note: previous declaration of 'dm_add_end_session'
      was here

icwmp_dm.c had a file-local helper that serialises the end-session flags a
setter left behind into the ubus reply.  libtr098 exports an unrelated
function of the same name -- the one a setter calls to QUEUE an end-session
action -- and inc/cwmp.h pulls dmtr098.h into every file of the app, so the
static definition followed a non-static declaration.

Renamed to dm_add_end_session_list(), matching the dm_add_fault_list() and
dm_add_param_list() helpers next to it.  Behaviour is unchanged: the engine
function was never called from here.

Third time this class of clash reached the build host (deviceinfo_mtk.c,
wlansec_mtk.c, now icwmp_dm.c), the first time in the app tree, where the
headers arrive as <icwmp_dm/...> from staging_dir.  check-c-sanity.py now
covers that tree too.

NOT BUILD-TESTED on this host: no compiler here.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 public/apps/icwmp/icwmp/icwmp_dm.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/public/apps/icwmp/icwmp/icwmp_dm.c b/public/apps/icwmp/icwmp/icwmp_dm.c
index 2f4d70d..9092602 100644
--- a/public/apps/icwmp/icwmp/icwmp_dm.c
+++ b/public/apps/icwmp/icwmp/icwmp_dm.c
@@ -135,8 +135,11 @@ static int dm_write_param_file(struct dmctx *dmctx, int cmd, const char *file)
 	return 0;
 }
 
-/* end-session flags a setter left behind (libtr098 end_session_flag) */
-static void dm_add_end_session(unsigned int flags)
+/* end-session flags a setter left behind (libtr098 end_session_flag).
+ * Not dm_add_end_session(): dmtr098.h:532 owns that name for the engine call
+ * that QUEUES an end-session action, and inc/cwmp.h pulls that header into
+ * every file here. */
+static void dm_add_end_session_list(unsigned int flags)
 {
 	static const struct { unsigned int bit; const char *name; } names[] = {
 		{ END_SESSION_RELOAD, "reload" }, { END_SESSION_REBOOT, "reboot" },
@@ -298,7 +301,7 @@ int icwmp_ubus_dm(struct ubus_context *ctx, struct ubus_object *obj,
 	pending = (unsigned int)end_session_flag;
 	if (changed) {
 		blobmsg_add_u8(&bb, "reloaded", reloaded);
-		dm_add_end_session(pending);
+		dm_add_end_session_list(pending);
 	}
 
 	ubus_send_reply(ctx, req, bb.head);
-- 
