-        else exit(EXIT_SUCCESS);
+        else {
+        	/* silent in upstream: another process holds the lock (an
+        	 * icwmpd still running, or a child that inherited the fd) */
+        	icwmp_boot_trace("/var/run/icwmpd.pid is locked by another process: EXIT 0");
+        	exit(EXIT_SUCCESS);
