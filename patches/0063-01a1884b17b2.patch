     dm_entry_load_enabled_notify(DM_CWMP, cwmp->conf.amd_version, cwmp->conf.instance_mode, add_list_value_change, send_active_value_change);
+    icwmp_boot_trace("dm_entry_load_enabled_notify done");
     return CWMP_OK;
