From d734ec189cf18eac756b3dcdbf7a44b3ab47882f Mon Sep 17 00:00:00 2001
From: TuNV <tunguyenvanbn94@gmail.com>
Date: Fri, 25 Sep 2026 14:25:05 +0700
Subject: [PATCH] [icwmp tr098] declare the dmjson array getters: a char * was
 returned as int

dmjson.h expands dmjson_get_value_in_array_idx() and
dmjson_foreach_value_in_array() into __dmjson_get_value_in_array_idx(),
which dmjson.c defines but no header declared.  gcc 10 took the implicit
"int" declaration and only warned, so the SDK build produced packages --
but on aarch64 the returned pointer lost its upper 32 bits.  Callers:
sdk/mtk/dm098/wanipv6_mtk.c (X_AIS_IPv6 DNS servers, P4d) and upstream
tr098/deviceinfo.c, where a "(char *)" cast hid even the warning.

Found by compiling with the SDK cross gcc and
-Werror=implicit-function-declaration; three more fixes from the same run,
none of them changing behaviour:
  - dmuci.h: prototype of dmuci_delete_by_section_unnamed_tr098 (generated
    by NEW_UCI_PATH, called from dmcommon.c, returns int);
  - dmentry.c: <ctype.h> for isdigit();
  - netlink.c: bind() takes a struct sockaddr *, not a sockaddr_in6 *.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 public/apps/icwmp/icwmp/netlink.c     | 2 +-
 public/libs/libicwmp_dm/src/dmentry.c | 1 +
 public/libs/libicwmp_dm/src/dmjson.h  | 7 +++++++
 public/libs/libicwmp_dm/src/dmuci.h   | 3 +++
 4 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/public/apps/icwmp/icwmp/netlink.c b/public/apps/icwmp/icwmp/netlink.c
index 3d65b39..c8b175d 100644
--- a/public/apps/icwmp/icwmp/netlink.c
+++ b/public/apps/icwmp/icwmp/netlink.c
@@ -244,7 +244,7 @@ int netlink_init_v6(void)
 
 	addr.nl_family = AF_NETLINK;
 	addr.nl_groups = RTMGRP_IPV6_IFADDR;
-	if ((bind(sock[0], (struct sockaddr_in6 *)&addr, sizeof(addr))) == -1) {
+	if ((bind(sock[0], (struct sockaddr *)&addr, sizeof(addr))) == -1) {
 		CWMP_LOG(ERROR,"couldn't bind netlink socket");
 		return -1;
 	}
diff --git a/public/libs/libicwmp_dm/src/dmentry.c b/public/libs/libicwmp_dm/src/dmentry.c
index 6ce717f..80e2e0a 100644
--- a/public/libs/libicwmp_dm/src/dmentry.c
+++ b/public/libs/libicwmp_dm/src/dmentry.c
@@ -20,6 +20,7 @@
 #include "wepkey.h"
 #include <unistd.h>
 #include <sys/wait.h>
+#include <ctype.h>
 #include "dmcommon.h"
 #include "dmtr098.h"
 
diff --git a/public/libs/libicwmp_dm/src/dmjson.h b/public/libs/libicwmp_dm/src/dmjson.h
index ffdb130..22c78d7 100644
--- a/public/libs/libicwmp_dm/src/dmjson.h
+++ b/public/libs/libicwmp_dm/src/dmjson.h
@@ -25,6 +25,13 @@ json_object *__dmjson_get_obj(json_object *mainjobj, int argc, ...);
 char *____dmjson_get_value_in_obj(json_object *mainjobj, char *argv[]);
 char *__dmjson_get_value_in_obj(json_object *mainjobj, int argc, ...);
 json_object *__dmjson_select_obj_in_array_idx(json_object *mainjobj, json_object **arrobj, int index, int argc, ...);
+/* Both were defined in dmjson.c but declared nowhere, so every
+ * dmjson_get_value_in_array_idx() / dmjson_foreach_value_in_array() caller
+ * got an implicit "int" declaration: on a 64-bit target the returned char *
+ * lost its upper 32 bits (gcc 10 only warns, and a "(char *)" cast at the
+ * call site hides even that). */
+char *____dmjson_get_value_in_array_idx(json_object *mainjobj, json_object **arrobj, int index, char *argv[]);
+char *__dmjson_get_value_in_array_idx(json_object *mainjobj, json_object **arrobj, char *defret, int index, int argc, ...);
 
 char *____dmjson_get_value_array_all(json_object *mainjobj, char *delim, char *argv[]);
 char *__dmjson_get_value_array_all(json_object *mainjobj, char *delim, int argc, ...);
diff --git a/public/libs/libicwmp_dm/src/dmuci.h b/public/libs/libicwmp_dm/src/dmuci.h
index 85ba74a..cc86d57 100644
--- a/public/libs/libicwmp_dm/src/dmuci.h
+++ b/public/libs/libicwmp_dm/src/dmuci.h
@@ -170,6 +170,9 @@ int dmuci_get_value_by_section_list(struct uci_section *s, char *option, struct
 char *dmuci_set_value_by_section(struct uci_section *s, char *option, char *value);
 int dmuci_delete_by_section(struct uci_section *s, char *option, char *value);
 int dmuci_delete_by_section_unnamed(struct uci_section *s, char *option, char *value);
+/* generated by NEW_UCI_PATH(tr098, ...) in dmuci.c and called by dmcommon.c,
+ * which had no declaration of it (implicit int) */
+int dmuci_delete_by_section_unnamed_tr098(struct uci_section *s, char *option, char *value);
 int dmuci_add_list_value_by_section(struct uci_section *s, char *option, char *value);
 int dmuci_del_list_value_by_section(struct uci_section *s, char *option, char *value);
 struct uci_section *dmuci_walk_section(char *package, char *stype, void *arg1, void *arg2, int cmp , int (*filter)(struct uci_section *s, void *value), struct uci_section *prev_section, int walk);
-- 
