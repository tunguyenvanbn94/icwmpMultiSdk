@@ -1121,7 +1166,10 @@ static char *stat_of(void *data, const char *counter)
 
 	if (!e)
 		return "";
-	dev = e->bridge ? mtk_uci("network", e->dev, "name") : entry_netdev(e);
+	if (e->ppp)
+		dev = iface_l3_device(e->if4);
+	else
