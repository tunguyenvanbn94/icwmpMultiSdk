+ * "kind" is the shell's $targe_conn_type of wan_device_get_total_entry():
+ * WANIPConnection takes the routed IPoE and the bridged entries,
+ * WANPPPConnection takes conn_type 2.  Every entry belongs to exactly one of
+ * the two objects, which is why one instance number can be reused on both.
  */
-static int wan_entries(struct wan_entry **out, int max)
+#define WAN_KIND_IP	0
+#define WAN_KIND_PPP	1
+
+static int wan_entries_kind(struct wan_entry **out, int max, int kind)
 {
 	struct uci_section *s;
 	int idx = 0, n = 0;
@@ -244,15 +275,22 @@ static int wan_entries(struct wan_entry **out, int max)
 		char *id = sect_opt(s, "id");
 		char *sw = sect_opt(s, "switch_mode");
 		long idv = 0, svc = 0;
-		int bridge;
+		int bridge = 0, ppp = 0;
 
 		if (!id[0])
 			break;
-		if (strcmp(sw, "1") == 0)
+		if (kind == WAN_KIND_PPP) {
+			if (strcmp(sw, "0") != 0 ||
+			    strcmp(sect_opt(s, "conn_type"), "2") != 0) {
+				idx++;
+				continue;
+			}
+			ppp = 1;
+		} else if (strcmp(sw, "1") == 0) {
 			bridge = 1;
-		else if (strcmp(sw, "0") == 0 && strcmp(sect_opt(s, "conn_type"), "0") == 0)
+		} else if (strcmp(sw, "0") == 0 && strcmp(sect_opt(s, "conn_type"), "0") == 0) {
 			bridge = 0;
-		else {
+		} else {
 			idx++;
 			continue;	/* PPPoE, or an entry with no mode at all */
 		}
@@ -268,6 +306,7 @@ static int wan_entries(struct wan_entry **out, int max)
 			e->idx = idx;
 			e->id = (int)idv;
 			e->bridge = bridge;
+			e->ppp = ppp;
 			if (str_is_uint(sect_opt(s, "service_type"), &svc))
 				e->tr069 = (svc & 2) ? 1 : 0;
 			entry_fill(e);
@@ -278,6 +317,11 @@ static int wan_entries(struct wan_entry **out, int max)
 	return n;
 }
 
+static int wan_entries(struct wan_entry **out, int max)
+{
+	return wan_entries_kind(out, max, WAN_KIND_IP);
+}
