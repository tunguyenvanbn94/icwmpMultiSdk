 	if (!dev[0])
 		return "";
 	snprintf(path, sizeof(path), "/sys/class/net/%s/statistics/%s", dev, counter);
@@ -1187,7 +1235,7 @@ static int add_ipconn_instance(char *refparam, struct dmctx *ctx, void *data, ch
 	return 0;
 }
 
-static int del_ipconn_instance(char *refparam, struct dmctx *ctx, void *data, char *instance, unsigned char del_action)
+static int del_conn_instance(char *refparam, struct dmctx *ctx, void *data, char *instance, unsigned char del_action)
 {
 	struct wan_entry *e = (struct wan_entry *)data;
 
@@ -1247,6 +1295,243 @@ static int browseWanIpConnInst(struct dmctx *dmctx, DMNODE *parent_node, void *p
