+	const char *v;
+
+	if (!e || !value)
+		return FAULT_9002;
+	if (strcmp(value, "SLAAC") == 0)
+		v = "0";
+	else if (strcmp(value, "Static") == 0)
+		v = "1";
+	else if (strcmp(value, "None") == 0)
+		v = "2";
+	else
+		return FAULT_9007;
+	if (action == VALUECHECK)
+		return 0;
+	dmuci_set_value_by_section(e->s, "v6_gw_type", (char *)v);
+	wan_reload();
+	return 0;
+}
