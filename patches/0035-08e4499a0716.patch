+{
+  "make.common": [
+    "CMS_DMP_FLAGS += -DSUPPORT_TR69C\nendif\n\nifneq ($(strip $(BUILD_TR69_TR143)),)\nifneq ($(strip $(BUILD_TR98_PROFILES)),)\nCMS_DMP_FLAGS += -DDMP_DOWNLOAD_1\n",
+    "CMS_DMP_FLAGS += -DSUPPORT_TR69C\nendif\n\nifneq ($(strip $(BUILD_ICWMP)),)\n# Open source CWMP client (userspace/public/apps/icwmp) replaces tr69c as the\n# process launched by tr69_md (SUPPORT_ICWMP in comp_tr69_md.c).  It needs\n# libuci, libmicroxml and libtr098 (userspace/public/libs) on top of the\n# ubus/json-c/curl/openssl stack already selected by the TR69C flags.\nCMS_DMP_FLAGS += -DSUPPORT_ICWMP\nBUILD_LIBUCI=y\nBUILD_LIBMICROXML=y\nBUILD_LIBTR098=y\nBUILD_LIBCURL=y\nBUILD_ZLIB=y\nexport BUILD_ICWMP BUILD_LIBUCI BUILD_LIBMICROXML BUILD_LIBTR098\nendif\n\nifneq ($(strip $(BUILD_TR69_TR143)),)\nifneq ($(strip $(BUILD_TR98_PROFILES)),)\nCMS_DMP_FLAGS += -DDMP_DOWNLOAD_1\n"
+  ],
+  "packages/common/mgmt/bcm_comp_md/comp_tr69_md.c": [
+    "   if (shmId == UNINITIALIZED_SHM_ID)\n      return BCMRET_INVALID_PARAM_VALUE;\n\n   // The -d option tells tr69c that we are in Distributed MDM (BDK) mode.\n   // The -x option tells tr69c that sysmgmt is ready, no need to wait \n   snprintf(args, sizeof(args), \"%s-m %d -d -I %d\", bootLaunch?\"\":\"-x \", shmId, instance);\n   snprintf(exe, sizeof(exe), \"tr69c%s\", (instance == 2) ? \"_2\" : \"\");\n   printf(\"launch %s with args=%s\\n\", exe, args);\n   ret = compMd_launchApp(prefix, exe, args, pid);\n   return ret;\n",
+    "   if (shmId == UNINITIALIZED_SHM_ID)\n      return BCMRET_INVALID_PARAM_VALUE;\n\n#ifdef SUPPORT_ICWMP\n   // icwmpd (open source CWMP client, see userspace/public/apps/icwmp) takes\n   // the place of tr69c in the tr69 component: same MDM shmId, same bus.\n   // -b = start with BOOT event, -S = MDM shmId, -X = sysmgmt is ready, do not\n   // wait (same meaning as tr69c -x).\n   (void) instance;\n   snprintf(args, sizeof(args), \"-b %s-S %d\", bootLaunch?\"\":\"-X \", shmId);\n   snprintf(exe, sizeof(exe), \"icwmpd\");\n#else\n   // The -d option tells tr69c that we are in Distributed MDM (BDK) mode.\n   // The -x option tells tr69c that sysmgmt is ready, no need to wait \n   snprintf(args, sizeof(args), \"%s-m %d -d -I %d\", bootLaunch?\"\":\"-x \", shmId, instance);\n   snprintf(exe, sizeof(exe), \"tr69c%s\", (instance == 2) ? \"_2\" : \"\");\n#endif\n   printf(\"launch %s with args=%s\\n\", exe, args);\n   ret = compMd_launchApp(prefix, exe, args, pid);\n   return ret;\n"
+  ]
+}
