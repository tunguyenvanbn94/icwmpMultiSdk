+int mtk_file_write(const char *path, const char *value)
+{
+	FILE *f;
+	int rc;
+
+	if (!path || !value)
+		return -1;
+	f = fopen(path, "w");
+	if (!f)
+		return -1;
+	rc = fprintf(f, "%s\n", value) < 0 ? -1 : 0;
+	if (fclose(f))
+		rc = -1;
+	return rc;
+}
