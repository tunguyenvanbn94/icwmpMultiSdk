new file mode 100644
index 0000000..1a37929
--- /dev/null
+++ b/public/libs/libicwmp_dm/src/README.md
@@ -0,0 +1,17 @@
+# libicwmp_dm
+
+Shared data model engine for icwmp, with BDK, MTK and UCI SDK backends.
+Source renamed from `public/libs/libtr098/libtr098` in A1. The build continues to
+produce **libtr098.so** with the existing ABI and package dependency.
+
+- Autotools root: this `src/` directory. BDK wrappers are one level above it.
+- Public headers: `<icwmp_dm/...>`. `tools/install-headers.sh` also installs
+  `<libtr098/...>` forwarding headers for existing consumers.
+- Configure: `./tools/sdk-scan.sh`, `autoreconf -fi`, `./configure --with-sdk=<sdk>`.
+- SDK selection/pruning: `tools/sdk-prune.sh`. Model-independent pruning is **not
+  implemented yet**. TR-181 still shares services with TR-098 in this baseline.
+- A1 changes paths and packaging integration only. Model names, persisted paths,
+  getter/setter behavior and library symbols are unchanged.
+
+Both app and library require a clean SDK build after the source/include rename.
+A1 has static validation only until the BDK and MTK builds and board tests pass.
diff --git a/public/libs/libicwmp_dm/src/bin/Makefile.am b/public/libs/libicwmp_dm/src/bin/Makefile.am
new file mode 100644
index 0000000..227ead7
--- /dev/null
+++ b/public/libs/libicwmp_dm/src/bin/Makefile.am
@@ -0,0 +1,70 @@
+TR098_VERSION = 3.0.0
+LIB_TR098_VERSION = 3:0:0
+
+lib_LTLIBRARIES = libtr098.la
+
+# Engine and storage helpers.  No SDK name appears in this file: the sources,
+# the CFLAGS and the extra libraries of the selected SDK come from
+# sdk/<name>/sdk.mk, pulled in by the generated sdk/enabled.mk.
+libtr098_la_SOURCES =	\
+	../md5.c					\
+	../dmtr098.c			\
+	../dmentry.c			\
+	../dmmem.c			\
+	../dmubus.c			\
+	../dmjson.c			\
+	../dmuci.c			\
+	../dmcommon.c		\
+	../dm_registry.c		\
+	../wepkey.c
+
+# Portable data model modules: no SDK specific call, every SDK may link them.
+# Which ones a build actually uses is decided in sdk/<name>/sdk.mk, except
+# these two, which every SDK has needed so far.
+libtr098_la_SOURCES +=	\
+	../tr098/managementserver.c			\
+	../tr098/softwaremodules.c			\
+	../tr098/common/icwmpcfg.c
+
+libtr098_la_CFLAGS =	\
+	$(AM_CFLAGS)			\
+	$(LIBUCI_CFLAGS)		\
+	$(LIBUBOX_CFLAGS)		\
+	$(LIBUBUS_CFLAGS)
+
+libtr098_la_LDFLAGS = 	\
+	$(AM_LDFLAGS)			\
+	$(LIBUCI_LDFLAGS)		\
+	$(LIBUBOX_LDFLAGS)		\
+	$(LIBUBUS_LDFLAGS)		\
+	-share					\
+	-version-info $(LIB_TR098_VERSION)
+
+libtr098_la_LIBADD =	\
+	$(AM_LIBS)				\
+	$(LIBUCI_LIBS)			\
+	$(LIBUBOX_LIBS)			\
+	$(LIBUBUS_LIBS)			\
+	$(LIBJSON_LIBS)			\
+	$(LBLOBMSG_LIBS)		\
+	-lpthread
+
+libtr098_la_CFLAGS+=-DTR098_VERSION=\"$(TR098_VERSION)\"
+libtr098_la_LDFLAGS+=-DTR098_VERSION=\"$(TR098_VERSION)\"
+
+libtr098_la_CFLAGS+=-I../
+libtr098_la_CFLAGS+=-I../tr098/
+libtr098_la_CFLAGS+=-I../tr098/common/
+libtr098_la_CFLAGS+=-I../upnp
+
+if UPNP_TR064
+libtr098_la_SOURCES +=							\
+	../upnp/upnp_deviceinfo.c	            \
+	../upnp/upnp_configuration.c			\
+	../upnp/upnp_monitoring.c				\
+	../upnp/upnp_common.c
+endif
+
+# One include line per SDK directory that exists; regenerate after adding or
+# deleting one:  ./tools/sdk-scan.sh
+include $(top_srcdir)/sdk/enabled.mk
