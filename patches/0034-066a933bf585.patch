-	mem_size_field = (char *)dmjson_get_value_in_array_idx(fields, 4, 0, NULL);
-	priority_field = (char *)dmjson_get_value_in_array_idx(fields, 8, 0, NULL);
-	cpu_time_field = (char *)dmjson_get_value_in_array_idx(fields, 9, 0, NULL);
-
-	if(nbre_process>0){
