+
+/*#Device.DeviceInfo.MemoryStatus.Free!UBUS:router.system/info//memoryKB.free*/
+int get_memory_status_free(char* refparam, struct dmctx *ctx, void *data, char *instance, char **value){
+	json_object *res;
+
