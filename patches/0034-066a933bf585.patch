-/* raw is 0.1 uW: dBm = 10 * log10(raw / 10000) */
-static int gpon_power(const char *key, char **value)
-{
-	char *raw = ponmgr_field("phyTransParams", key);
-	char buf[32];
-	char *end = NULL;
-	long v;
-	double mw;
-
-	*value = "";
-	if (!raw || !raw[0])
-		return 0;
-	v = strtol(raw, &end, 10);
-	if (end == raw || v <= 0)
-		return 0;
-	mw = (double)v / 10000.0;
-	snprintf(buf, sizeof(buf), "%.1fdBm", 10.0 * log10(mw));
-	*value = dmstrdup(buf);
-	return 0;
-}
