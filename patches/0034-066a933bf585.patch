-static int set_mlo_key_passphrase(char *refparam, struct dmctx *ctx, void *data, char *instance, char *value, int action)
-{
-	size_t len = strlen(value), k;
-	int i, fault;
-
-	(void)data; (void)instance;
-	if (len == 64) {
-		for (k = 0; k < len; k++)
-			if (!isxdigit((unsigned char)value[k]))
-				return FAULT_9007;
