-static int dmentry_external_cmd(char **argv)
-{
-	int pid;
-
-	if ((pid = fork()) == -1)
-		return -1;
-
-	if (pid == 0) {
-		/* child */
-		execvp(argv[0], argv);
-		exit(ESRCH);
-
-	} else if (pid < 0)
-		return -1;
-
-	int status;
-	while (wait(&status) != pid);
-
-	return 0;
-}
