+int string_to_bool(char *v, bool *b)
+{
+	if (v[0] == '1' && v[1] == '\0') {
+		*b = true;
+		return 0;
+	}
+	if (v[0] == '0' && v[1] == '\0') {
+		*b = false;
+		return 0;
+	}
+	if (strcasecmp(v, "true") == 0) {
+		*b = true;
+		return 0;
+	}
+	if (strcasecmp(v, "false") == 0) {
+		*b = false;
+		return 0;
+	}
+	*b = false;
+	return -1;
+}
