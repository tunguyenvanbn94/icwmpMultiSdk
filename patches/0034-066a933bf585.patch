+	char ref[64];
+
+	(void)refparam; (void)ctx; (void)instance;
+	ipif_ref_of(oc, ref, sizeof(ref));
+	if (oc && bdk_get_instances("Device.NAT.PortMapping.", &inst, &num) == 0)
+		for (i = 0; i < num; i++)
+			if (portmapping_on(inst[i], ref))
+				n++;
+	dmasprintf(value, "%u", n);
+	return 0;
+}
