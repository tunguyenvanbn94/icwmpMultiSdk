+static inline void uci_list_insert(struct uci_list *list, struct uci_list *ptr)
+{
+	list->next->prev = ptr;
+	ptr->prev = list;
+	ptr->next = list->next;
+	list->next = ptr;
+}
+
+static inline void uci_list_add(struct uci_list *head, struct uci_list *ptr)
+{
+	uci_list_insert(head->prev, ptr);
+}
