+	printf(" upnp_check_changed_parametrs_event\n");
+	printf(" upnp_check_changed_parametrs_version\n");
+#endif
+	printf(" external_command <command> [arg 1] [arg 2] ... [arg N]\n");
+	printf(" exit\n");
+}
