+void codec_update_id()
+{
+	int i = 0;
+	int found = 0;
+	struct uci_section *s = NULL;
+	struct uci_section *ss = NULL;
+
+	for (i = 0; i < available_sip_codecs; i++) {
+		update_section_list(DMMAP,"codec_id", "id", 1, allowed_sip_codecs[i].id, NULL, NULL, NULL, NULL);
+	}
+	if(i == 0)
+	{
+		uci_path_foreach_sections(tr098, "dmmap", "codec_id", s) {
+			if (found != 0) {
+				DMUCI_DELETE_BY_SECTION(tr098, ss, NULL, NULL);
+			}
+			ss = s;
+			found++;
+		}
+		if (ss != NULL) {
+			DMUCI_DELETE_BY_SECTION(tr098, ss, NULL, NULL);
+		}
+	}
