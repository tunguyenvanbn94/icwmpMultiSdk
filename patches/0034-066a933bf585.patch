-static char *parse_arg_r(char *pch, char **last)
-{
-	if (pch == NULL) {
-		pch = *last;
-	}
-
-	if (pch == NULL) {
-		return NULL;
-	}
-
-	for(; *pch != '\0'; pch++)
-	{
-		if(*pch == ' ' || *pch == '\t')
-			continue;
-		if (*pch == '"')
-		{
-			char *s = strchr(++pch, '"');
-			if(s) {
-				*s = '\0';
-				*last = s + 1;
-				return pch;
-			}
-			else {
-				*last = NULL;
-				return NULL;
-			}
-		}
-		else
-		{
-			char *s = strchr(pch, ' ');
-			if(s) {
-				*s = '\0';
-				 *last = s + 1;
-			}
-			else {
-				s = strchr(pch, '\t');
-				if(s) {
-					*s = '\0';
-					 *last = s + 1;
-				}
-				else {
-					*last = NULL;
-				}
-			}
-
-			return pch;
-		}
-	}
-	*last = NULL;
-	return NULL;
-}
