+	DMUCI_SET_VALUE_BY_SECTION(tr098, ss, "bridgekey", bridge_key);
+	DMUCI_SET_VALUE_BY_SECTION(tr098, ss, "name", name);
+	DMUCI_SET_VALUE_BY_SECTION(tr098, ss, "vid", vid);
+	DMUCI_SET_VALUE_BY_SECTION(tr098, ss, "ifname", ifname);
