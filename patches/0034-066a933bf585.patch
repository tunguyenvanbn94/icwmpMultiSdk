+static struct uci_section *update_route_dynamic_section(struct proc_routing *proute)
+{
+	struct uci_section *s = NULL;
+	char *name, *mask, *last_inst, *instance;
+	uci_path_foreach_option_eq(tr098, "dmmap_route_forwarding", "route_dynamic", "target", proute->destination, s) {
+		dmuci_get_value_by_section_string(s, "netmask", &mask);
+		if (strcmp(proute->mask, mask) == 0)
+			return s;
+	}
+	if (!s) {
+		last_inst = get_last_instance_route_forwarding();
+		dmasprintf(&instance, "%d", atoi(last_inst)+1);
+		DMUCI_ADD_SECTION(tr098, "dmmap_route_forwarding", "route_dynamic", &s, &name);
+		DMUCI_SET_VALUE_BY_SECTION(tr098, s, "target", proute->destination);
+		DMUCI_SET_VALUE_BY_SECTION(tr098, s, "netmask", proute->mask);
+		DMUCI_SET_VALUE_BY_SECTION(tr098, s, "metric", proute->metric);
+		DMUCI_SET_VALUE_BY_SECTION(tr098, s, "gateway", proute->gateway);
+		DMUCI_SET_VALUE_BY_SECTION(tr098, s, "interface", proute->iface);
+		DMUCI_SET_VALUE_BY_SECTION(tr098, s, "routeinstance", instance);
+		dmfree(instance);
+	}
+	return s;
+}
