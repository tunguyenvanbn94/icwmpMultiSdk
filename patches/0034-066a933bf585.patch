+int get_wan_device_wan_dsl_traffic()
+{
+	json_object *res;
+	int dsl = WAN_DSL_NODSL;
+	char *str;
+
+	dmubus_call("router.dsl", "stats", UBUS_ARGS{}, 0, &res);
+	if (!res) 
+		return dsl;
+	str = dmjson_get_value(res, 2, "dslstats", "traffic");
+	if (str) {
+		if (strstr(str, "ATM")) {
+			dsl = WAN_DSL_ADSL;
+		}
+		else if (strstr(str, "PTM")) {
+			dsl = WAN_DSL_VDSL;
+		}
+	}
+	return dsl;
+}
