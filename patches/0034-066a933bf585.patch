+			value = dmstrdup(value);
+			pch = strtok_r(value, " ", &spch);
+			while (pch != NULL) {
+				dmuci_add_list_value_by_section(owsd_listensection, "origin", pch);
+				pch = strtok_r(NULL, " ", &spch);
