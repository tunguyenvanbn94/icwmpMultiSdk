+		list_for_each_entry(p1, &dup_list_dhcp, list) {
+			idhcp = handle_update_instance(2, dmctx, &idhcp_last, update_instance_alias, 3, p1->dmmap_section, "ldhcpinstance", "ldhcpalias");
