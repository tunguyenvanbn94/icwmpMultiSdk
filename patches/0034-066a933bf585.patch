-	(void)parameter_key;
-	return 0;
-#else
-	struct mtk_reply r;
-	struct set_tmp *n;
-	int script_params = 0, reload = 0;
-
-	list_for_each_entry(n, &ctx->set_list_tmp, list) {
-		if (mtk_is_native(n->name))
-			continue;
-		script_params++;
