+	switch (action) {
+		case VALUECHECK:
+			if (error)
+				return FAULT_9007;
+			return 0;
+		case VALUESET:
+			set_bridge_vlan_enable_sub(refparam, ctx, data, instance, b);
+			return 0;
+	}
+	return 0;
+}
