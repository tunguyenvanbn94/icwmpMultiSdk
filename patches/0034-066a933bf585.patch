-static inline int isword_delim(char c)
-{
-	if (c == ' ' ||
-		c == ',' ||
-		c == '\t' ||
-		c == '\v' ||
-		c == '\r' ||
-		c == '\n' ||
-		c == '\0')
-		return 1;
-	return 0;
-}
-
-char *dm_strword(char *src, char *str)
-{
-	char *ret = src;
-	int len;
-	if (src[0] == '\0')
-		return NULL;
-	len = strlen(str);
-	while ((ret = strstr(ret, str)) != NULL) {
-		if ((ret == src && isword_delim(ret[len])) ||
-			(ret != src && isword_delim(ret[len]) && isword_delim(*(ret - 1))))
-			return ret;
-		ret++;
-	}
-	return NULL;
-}
