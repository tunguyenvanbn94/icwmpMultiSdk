-static void mlo_set_kernel_cfg(const char *cfg)
-{
-	nv_kset(KNV_MLO_CONFIG, cfg);
-	nv_kcommit();
-	cmsLog_notice("wl_mlo_config=\"%s\": takes effect after reboot", cfg);
-}
