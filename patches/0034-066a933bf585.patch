-		sprintf(ret, "%d.%d.%d.%d", ip[0], ip[1], ip[2], ip[3]);
-	} else {
-		sprintf(ret, "%d.%d.%d.%d", ip[3], ip[2], ip[1], ip[0]);
-	}
