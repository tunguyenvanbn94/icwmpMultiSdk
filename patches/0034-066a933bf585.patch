-static const struct mtk_tz_entry *tz_lookup(const char *city)
-{
-	int i;
-
-	if (!city)
-		return NULL;
-	for (i = 0; mtk_tz_table[i].city; i++) {
-		if (strcmp(mtk_tz_table[i].city, city) == 0)
-			return &mtk_tz_table[i];
