+	dmuci_set_value_by_section(rule, "parental", "0");
+
+	dmuci_add_section_tr098("dmmap_firewall", "rule", &dmmap_rule, &v);
+	dmuci_set_value_by_section(dmmap_rule, "section_name", section_name(rule));
