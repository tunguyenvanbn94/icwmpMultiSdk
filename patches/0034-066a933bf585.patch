+
+		if (strcmp(value, "-") == 0)
+		{
+			found=1;
+			break;
+		}
+		else if (i >= line_number) {
+			i = 0;
+			break;
+		}
+	}
+	if (found == 1)
+		*tel_section = s;
+	else {
+		i=0;
+		*tel_section = NULL;
+	}
+	return i;
+}
