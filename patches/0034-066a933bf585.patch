+				//do not add baseifname if exist
+				add_sec = false;
+			}
+		}
+		if (prev_s) {
+			DMUCI_DELETE_BY_SECTION(tr098, prev_s, NULL, NULL);
+		}
+		if (add_sec) {
+			DMUCI_ADD_SECTION(tr098, config, section, &s, &add_value);
+			DMUCI_SET_VALUE_BY_SECTION(tr098, s, option, val);
+			DMUCI_SET_VALUE_BY_SECTION(tr098, s, option_2, val_2);
+		}
+	}
+	else
