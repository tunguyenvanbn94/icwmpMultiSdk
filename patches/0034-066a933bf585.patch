+int get_wan_device_wan_access_type(char *refparam, struct dmctx *ctx, void *data, char *instance, char **value)
+{
+	struct wanargs *wandargs = (struct wanargs *)data;
+	switch(wandargs->instance) {
+		case WAN_INST_ETH:
+			*value = "Ethernet";
+			break;
+		case WAN_INST_ATM:
+		case WAN_INST_PTM:
+			*value = "DSL";
+			break;
+		default:
+			*value = "";
+			break;
+	}
+	return 0;
+}
