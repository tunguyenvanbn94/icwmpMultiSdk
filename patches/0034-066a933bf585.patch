-	{"WPA2-Personal",     "11i"},
-	{"WPA-WPA2-Personal", "WPAand11i"},
-	{"WPA3-Personal",     "11i"},
-	{"WPA3-Personal-Transition", "11i"},
-	{"WPA-Enterprise",    "WPA"},
