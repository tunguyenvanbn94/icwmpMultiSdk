+int set_time_LocalTimeZone(char *refparam, struct dmctx *ctx, void *data, char *instance, char *value, int action)
+{
+	switch (action) {
+		case VALUECHECK:
+			break;
+		case VALUESET:
+			dmuci_set_value("system", "@system[0]", "timezone", value);
+			break;
+	}
+	return 0;
+}
