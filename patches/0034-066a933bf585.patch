+char *update_instance_tr098(struct uci_section *s, char *last_inst, char *inst_opt)
+{
+	char *instance;
+	void *argv[3];
+
+	argv[0]= s;
+	argv[1]= inst_opt;
+	argv[2]= "";
+	instance = update_instance_alias_tr098(0, &last_inst, argv);
+	return instance;
+}
+
+char *update_instance_alias_tr098(int action, char **last_inst , void *argv[])
+{
+	char *instance;
+	char *alias;
+	char buf[64] = {0};
+	struct uci_section *s = (struct uci_section *) argv[0];
+	char *inst_opt = (char *) argv[1];
+	char *alias_opt = (char *) argv[2];
+	dmuci_get_value_by_section_string(s, inst_opt, &instance);
+	if (instance[0] == '\0') {
+		if (*last_inst == NULL)
+			sprintf(buf, "%d", 1);
+		else
+			sprintf(buf, "%d", atoi(*last_inst)+1);
+		instance = DMUCI_SET_VALUE_BY_SECTION(tr098, s, inst_opt, buf);
+	}
+	*last_inst = instance;
+	if (action == INSTANCE_MODE_ALIAS) {
+		dmuci_get_value_by_section_string(s, alias_opt, &alias);
+		if (alias[0] == '\0') {
+			sprintf(buf, "cpe-%s", instance);
+			alias = DMUCI_SET_VALUE_BY_SECTION(tr098, s, alias_opt, buf);
+		}
+		sprintf(buf, "[%s]", alias);
+		instance = dmstrdup(buf);
+	}
+	return instance;
+}
