- *   WEP-64 / WEP-128      <-> Basic
- *   WPA-Personal          <-> WPA
- *   WPA2-Personal, WPA3-* <-> 11i
- *   WPA-WPA2-Personal     <-> WPAand11i
- */
-static const struct { const char *mode; const char *beacon; } beacon_tbl[] = {
-	{"None",              "None"},
