+	char *instance = NULL, *last_instance  = NULL, *value;
+	bool add_sec = true;
+
+	if (name[0] == '\0') {
+		add_sec = false;
+	}
+		if (config == DMMAP)
+	{
+		uci_path_foreach_option_eq(tr098, config, section, option_2, val_2, s) {
