-	/* "+0700" -> "+07:00" */
-	if (strlen(buf) >= 5) {
-		size_t l = strlen(buf);
-
-		buf[l + 1] = '\0';
-		buf[l] = buf[l - 1];
-		buf[l - 1] = buf[l - 2];
-		buf[l - 2] = ':';
