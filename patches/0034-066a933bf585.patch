-	for (i = 0; devinfo_override[i].leaf; i++) {
-		if (strcmp(devinfo_override[i].leaf, leaf) != 0)
-			continue;
-		dmuci_get_option_value_string("cwmp", "cpe", (char *)devinfo_override[i].uci, &v);
-		if (v && *v) {
-			*value = v;              /* dm-allocated by dmuci */
-			return 1;
-		}
-		return 0;
-	}
-	return 0;
-}
