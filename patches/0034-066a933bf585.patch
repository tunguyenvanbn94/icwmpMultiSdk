-	snprintf(path, sizeof(path), "%sStatus", oc ? oc->tr181_base : "");
-	bdk_get_value_default(path, "Disabled", &v);
-	*value = (strcmp(v, "Enabled") == 0) ? "Enabled" : (strncmp(v, "Error", 5) == 0 ? "Error" : "Disabled");
-	return 0;
