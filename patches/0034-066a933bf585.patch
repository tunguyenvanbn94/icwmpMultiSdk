+	struct in_addr ip_addr;
+	uint8_t u_bits = (uint8_t)bits;
+	char *netmask;
+	char tmp[32] = {0};
+
+	mask = ((0xFFFFFFFFUL << (32 - u_bits)) & 0xFFFFFFFFUL);
+	mask = htonl(mask);
+	ip_addr.s_addr = mask;
+	return inet_ntoa(ip_addr);
+}
