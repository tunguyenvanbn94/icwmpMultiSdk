+/*#Device.ManagementServer.ConnectionRequestURL!UCI:cwmp/cwmp,cpe/port*/
+int get_management_server_connection_request_url(char *refparam, struct dmctx *ctx, void *data, char *instance, char **value)
+{
+	char *ip, *port, *iface;
+
+	*value = "";
+#ifdef DM_PLATFORM_BDK
+	/* no netifd here: the address of cwmp.cpe.interface is the one icwmpd's
+	 * netlink watcher stores in the UCI state (netlink.c cwmp.cpe.ip / ipv6),
+	 * the same it uses for its connection request server */
+	(void)iface;
+	dmuci_get_varstate_string("cwmp", "cpe", (ip_version == 6) ? "ipv6" : "ip", &ip);
+	if (ip[0] == '\0' && ip_version == 6)
+		dmuci_get_varstate_string("cwmp", "cpe", "ip", &ip);
+	/* behind NAT (WAN of the AP is a private LAN of an ONT): the ACS must be
+	 * told the address/port it can reach, i.e. the ONT side of a port forward.
+	 * cwmp.cpe.cr_host (+ cr_port, default = cpe.port) override what goes into
+	 * ConnectionRequestURL; the CR server itself still listens on cpe.port */
+	{
+		char *host;
+
+		dmuci_get_option_value_string("cwmp", "cpe", "cr_host", &host);
+		if (host[0] != '\0')
+			ip = host;
+	}
+	dmuci_get_option_value_string("cwmp", "cpe", "cr_port", &port);
+	if (port[0] == '\0')
+		dmuci_get_option_value_string("cwmp", "cpe", "port", &port);
+#else
+	dmuci_get_option_value_string("cwmp", "cpe", "default_wan_interface", &iface);
+	network_get_ipaddr(&ip, iface);	
+	dmuci_get_option_value_string("cwmp", "cpe", "port", &port);
+#endif
+	if (ip[0] != '\0' && port[0] != '\0') {
+		char buf[128];
+		/* IPv6 literal (no override, ip_version 6) needs brackets */
+		if (strchr(ip, ':') && ip[0] != '[')
+			snprintf(buf, sizeof(buf), "http://[%s]:%s/", ip, port);
+		else
+			snprintf(buf, sizeof(buf), "http://%s:%s/", ip, port);
+		*value = dmstrdup(buf); //  MEM WILL BE FREED IN DMMEMCLEAN
+	}
+	return 0;
+}
