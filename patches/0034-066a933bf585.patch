+	bdk_get_value_default(BDK_LAN_DHCP_POOL "DNSServers", "", &v);
+	if (lan_dns_is_unset(v))
+		bdk_get_value_default(BDK_LAN_DHCP_POOL "IPRouters", "", &v);
+	*value = v;
+	return 0;
+}
