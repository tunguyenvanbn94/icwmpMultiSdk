+static char *get_last_instance_route_forwarding(void)
+{
+	char *inst_route, *inst_route_dynamic, *inst_route_disabled;
+	char *inst = "0";
+
+	inst_route = get_last_instance_tr098("dmmap_route_forwarding", "route", "routeinstance");
+	if (inst_route == NULL)
+		inst_route = "0";
+	inst_route_dynamic = get_last_instance_tr098("dmmap_route_forwarding", "route_dynamic", "routeinstance");
+	if (inst_route_dynamic == NULL)
+		inst_route_dynamic = "0";
+	inst_route_disabled = get_last_instance_tr098("dmmap_route_forwarding", "route_disabled", "routeinstance");
+	if (inst_route_disabled == NULL)
+		inst_route_disabled = "0";
+	if(atoi(inst_route) > atoi(inst_route_dynamic))
+		inst = inst_route;
+	else
+		inst = inst_route_dynamic;
+	if(atoi(inst_route_disabled) > atoi(inst))
+		inst = inst_route_disabled;
+	return inst;
+}
