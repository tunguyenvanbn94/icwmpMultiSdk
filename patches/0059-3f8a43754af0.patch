+TR143_GET(get_dld_interface,  DLD, "Interface",           NULL)
+TR143_GET(get_dld_transports, DLD, "DownloadTransports",  "HTTP,FTP")
+TR143_GET(get_dld_dscp,       DLD, "DSCP",                "0")
+TR143_GET(get_dld_url,        DLD, "DownloadURL",         NULL)
