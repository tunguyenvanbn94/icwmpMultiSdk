{
  "name": "Uplink",
  "description": "icwmp multi-SDK design system for progress, apply, coverage and CWMP log tooling",
  "color": {
    "paper": "#F4F2EC",
    "surface": "#FBFAF7",
    "sunken": "#EAE7DE",
    "line": "#D9D5CA",
    "line-strong": "#B8B3A5",
    "ink": "#17161A",
    "ink-2": "#3D3A33",
    "ink-3": "#6A665C",
    "signal": "#1F4FBF",
    "signal-press": "#163B91",
    "signal-soft": "#E3EAFA",
    "console": {
      "bg": "#121417",
      "line": "#22262C",
      "text": "#D8DCE2",
      "muted": "#8A919C"
    },
    "sdk": {
      "bdk": {"fg": "#0F5E6E", "bg": "#DDEEF0"},
      "mtk": {"fg": "#8A4B1F", "bg": "#F5E6DA"}
    }
  },
  "status": {
    "PLANNED": {"bg": "transparent", "border": "1.5px dashed #8A857A", "fg": "#5F5B52"},
    "PARTIAL": {"bg": "#FCEBD3", "border": "1.5px solid #B45309", "fg": "#93400A"},
    "STATIC_VERIFIED": {"bg": "#FFFFFF", "border": "1.5px solid #1E7A4C", "fg": "#1E7A4C"},
    "BUILD_PASS": {"bg": "#CFEBDB", "border": "1.5px solid #1E7A4C", "fg": "#155C39"},
    "BOARD_PASS": {"bg": "#1B6B43", "border": "1.5px solid #1B6B43", "fg": "#FFFFFF"},
    "NOT_RUN": {"bg": "#EAE7DE", "border": "1.5px solid #EAE7DE", "fg": "#5F5B52"},
    "NOT_READY": {"bg": "#FDE3E0", "border": "1.5px solid #B42318", "fg": "#B42318"}
  },
  "log": {
    "paper": {"CRIT": "#7A1010", "ERROR": "#B42318", "WARNING": "#A34A06", "NOTICE": "#1F4FBF", "INFO": "#3D3A33", "DEBUG": "#6A665C"},
    "console": {"CRIT": "#FF7A6E", "ERROR": "#FF7A6E", "WARNING": "#F5B454", "NOTICE": "#8AB4FF", "INFO": "#D8DCE2", "DEBUG": "#8A919C"}
  },
  "font": {
    "display": "'IBM Plex Sans Condensed', sans-serif",
    "body": "'IBM Plex Sans', sans-serif",
    "mono": "'IBM Plex Mono', monospace"
  },
  "type": {
    "display": {"family": "display", "size": 56, "line": 60, "weight": 700},
    "h1": {"family": "display", "size": 36, "line": 40, "weight": 600},
    "h2": {"family": "display", "size": 24, "line": 30, "weight": 600},
    "h3": {"family": "body", "size": 18, "line": 26, "weight": 600},
    "body": {"family": "body", "size": 16, "line": 24, "weight": 400},
    "small": {"family": "body", "size": 14, "line": 20, "weight": 400},
    "label": {"family": "mono", "size": 12, "line": 16, "weight": 500, "tracking": "0.08em", "case": "upper"},
    "path": {"family": "mono", "size": 14, "line": 20, "weight": 400, "leafWeight": 600},
    "code": {"family": "mono", "size": 13, "line": 20, "weight": 400}
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64],
  "radius": {"sm": 2, "md": 4, "lg": 8, "pill": 999},
  "control": {"minHeight": 44, "focus": "2px solid #1F4FBF, offset 2px"}
}
